<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SubeAI Videos - AI Video Generation Platform</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f5f3ff',
                            100: '#ede9fe',
                            500: '#8b5cf6',
                            600: '#7c3aed',
                            700: '#6d28d9',
                            900: '#4c1d95',
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Puter.js SDK -->
    <script src="https://js.puter.com/v2/"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .glass-panel {
            background: rgba(17, 24, 39, 0.75);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .glow-effect {
            box-shadow: 0 0 40px -10px rgba(124, 58, 237, 0.3);
        }
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #0f172a; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #475569; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased selection:bg-purple-500 selection:text-white">

    <!-- Header Navigation -->
    <header class="sticky top-0 z-50 glass-panel border-b border-slate-800/80 px-4 lg:px-8 py-3.5 flex items-center justify-between">
        <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-600 to-indigo-500 flex items-center justify-center glow-effect">
                <i class="fa-solid fa-clapperboard text-white text-lg"></i>
            </div>
            <div>
                <h1 class="font-bold text-lg tracking-tight bg-gradient-to-r from-white via-slate-200 to-purple-300 bg-clip-text text-transparent">SubeAI Videos</h1>
                <p class="text-xs text-slate-400">Powered by Puter.js AI & Cloud</p>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <nav class="hidden md:flex items-center space-x-1 bg-slate-900/80 p-1 rounded-xl border border-slate-800">
            <button onclick="switchTab('create')" id="tab-create" class="px-4 py-2 rounded-lg text-sm font-medium transition-all bg-purple-600 text-white shadow-sm">
                <i class="fa-solid fa-wand-magic-sparkles mr-2"></i>Generate
            </button>
            <button onclick="switchTab('gallery')" id="tab-gallery" class="px-4 py-2 rounded-lg text-sm font-medium transition-all text-slate-400 hover:text-white hover:bg-slate-800">
                <i class="fa-solid fa-film mr-2"></i>Gallery & Files
            </button>
            <button onclick="switchTab('models')" id="tab-models" class="px-4 py-2 rounded-lg text-sm font-medium transition-all text-slate-400 hover:text-white hover:bg-slate-800">
                <i class="fa-solid fa-microchip mr-2"></i>Models & Tokens
            </button>
        </nav>

        <!-- Puter Account & Token Status Widget -->
        <div class="flex items-center space-x-3">
            <div id="auth-widget" class="flex items-center space-x-3 bg-slate-900/90 border border-slate-800 px-3.5 py-1.5 rounded-full text-sm">
                <div id="auth-status-indicator" class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></div>
                <span id="auth-username" class="text-slate-300 font-medium">Not Connected</span>
                <div id="token-display" class="hidden items-center space-x-1 bg-purple-950/80 border border-purple-800/50 text-purple-300 px-2.5 py-0.5 rounded-full text-xs font-semibold">
                    <i class="fa-solid fa-coins text-amber-400 mr-1"></i>
                    <span id="token-count">--</span> Credits
                </div>
                <button id="auth-action-btn" onclick="handlePuterAuth()" class="ml-2 bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold px-3 py-1.5 rounded-full transition-all shadow-sm">
                    Connect Puter
                </button>
            </div>
        </div>
    </header>

    <!-- Mobile Subnav Bar -->
    <div class="md:hidden flex justify-around bg-slate-900 border-b border-slate-800 p-2">
        <button onclick="switchTab('create')" id="mobile-tab-create" class="flex-1 py-2 text-center text-xs font-medium text-purple-400 border-b-2 border-purple-500">Generate</button>
        <button onclick="switchTab('gallery')" id="mobile-tab-gallery" class="flex-1 py-2 text-center text-xs font-medium text-slate-400">Gallery</button>
        <button onclick="switchTab('models')" id="mobile-tab-models" class="flex-1 py-2 text-center text-xs font-medium text-slate-400">Models</button>
    </div>

    <main class="flex-1 max-w-7xl w-full mx-auto p-4 lg:p-8">

        <!-- VIEW 1: GENERATE VIDEO -->
        <div id="view-create" class="space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                
                <!-- Left Column: Controls & Configuration -->
                <div class="lg:col-span-2 space-y-6">
                    <div class="glass-panel rounded-2xl p-6 shadow-xl space-y-5">
                        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
                            <h2 class="text-xl font-bold flex items-center">
                                <i class="fa-solid fa-video text-purple-400 mr-2.5"></i>Text-to-Video Generator
                            </h2>
                            <div class="flex items-center space-x-2">
                                <span class="text-xs text-slate-400 font-medium">Test Mode (Free):</span>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="test-mode-toggle" class="sr-only peer">
                                    <div class="w-9 h-5 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-purple-600"></div>
                                </label>
                            </div>
                        </div>

                        <!-- Prompt Input -->
                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-slate-300 flex justify-between">
                                <span>Video Prompt Description <span class="text-purple-400">*</span></span>
                                <span id="prompt-char-count" class="text-xs text-slate-500">0 / 1000</span>
                            </label>
                            <textarea id="prompt-input" rows="4" 
                                class="w-full bg-slate-900 border border-slate-800 rounded-xl p-3.5 text-slate-100 placeholder-slate-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all resize-none"
                                placeholder="A cinematic drone shot flying over a serene alpine lake at golden hour, 4K resolution, hyper-realistic..."></textarea>
                        </div>

                        <!-- Model Selection Grid -->
                        <div class="space-y-2">
                            <label class="block text-sm font-medium text-slate-300">Select Video Model & Provider</label>
                            <select id="model-select" onchange="updateModelOptions()" class="w-full bg-slate-900 border border-slate-800 rounded-xl p-3 text-slate-100 focus:outline-none focus:border-purple-500 transition-all">
                                <optgroup label="OpenAI Sora Models">
                                    <option value="sora-2" data-provider="openai" data-cost="50">Sora-2 (Standard - Up to 12s)</option>
                                    <option value="sora-2-pro" data-provider="openai" data-cost="120" selected>Sora-2 Pro (Cinematic Quality)</option>
                                </optgroup>
                                <optgroup label="Google Veo Models">
                                    <option value="veo-3.1-generate-preview" data-provider="gemini" data-cost="90">Google Veo 3.1 Preview (High Fidelity)</option>
                                    <option value="veo-3.1-fast-generate-preview" data-provider="gemini" data-cost="45">Google Veo 3.1 Fast</option>
                                    <option value="veo-3.0-generate-001" data-provider="gemini" data-cost="80">Google Veo 3.0</option>
                                    <option value="veo-2.0-generate-001" data-provider="gemini" data-cost="60">Google Veo 2.0</option>
                                </optgroup>
                                <optgroup label="Together AI Models">
                                    <option value="together-video-xl" data-provider="together" data-cost="30">Together AI Video XL</option>
                                </optgroup>
                            </select>
                        </div>

                        <!-- Advanced Parameters Grid -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                            <!-- Duration / Seconds -->
                            <div class="space-y-1.5">
                                <label class="block text-xs font-medium text-slate-400">Clip Duration (Seconds)</label>
                                <select id="seconds-select" class="w-full bg-slate-900 border border-slate-800 rounded-xl p-2.5 text-sm text-slate-100 focus:outline-none focus:border-purple-500">
                                    <option value="4">4 Seconds</option>
                                    <option value="6">6 Seconds</option>
                                    <option value="8" selected>8 Seconds</option>
                                    <option value="12">12 Seconds (Sora only)</option>
                                </select>
                            </div>

                            <!-- Resolution / Size -->
                            <div class="space-y-1.5">
                                <label class="block text-xs font-medium text-slate-400">Resolution / Size</label>
                                <select id="size-select" class="w-full bg-slate-900 border border-slate-800 rounded-xl p-2.5 text-sm text-slate-100 focus:outline-none focus:border-purple-500">
                                    <option value="1280x720">1280x720 (Landscape HD)</option>
                                    <option value="720x1280">720x1280 (Vertical Mobile)</option>
                                    <option value="1920x1080" selected>1920x1080 (1080p Full HD)</option>
                                    <option value="3840x2160">3840x2160 (4K Ultra HD)</option>
                                </select>
                            </div>
                        </div>

                        <!-- Negative Prompt & Puter Path -->
                        <div class="space-y-4 pt-2">
                            <div id="negative-prompt-container" class="space-y-1.5">
                                <label class="block text-xs font-medium text-slate-400">Negative Prompt (What to avoid)</label>
                                <input type="text" id="negative-prompt-input" placeholder="blur, low quality, distortion, artifacts..."
                                    class="w-full bg-slate-900 border border-slate-800 rounded-xl p-2.5 text-sm text-slate-100 placeholder-slate-600 focus:outline-none focus:border-purple-500">
                            </div>

                            <div class="space-y-1.5">
                                <label class="block text-xs font-medium text-slate-400">Save to Puter Filesystem Path (Optional)</label>
                                <input type="text" id="puter-path-input" placeholder="videos/my_generated_clip.mp4" value="videos/subeai_clip.mp4"
                                    class="w-full bg-slate-900 border border-slate-800 rounded-xl p-2.5 text-sm text-slate-100 placeholder-slate-600 focus:outline-none focus:border-purple-500">
                            </div>
                        </div>

                        <!-- Generate Button -->
                        <div class="pt-4">
                            <button onclick="generateVideo()" id="generate-btn" class="w-full bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold py-3.5 px-6 rounded-xl shadow-lg shadow-purple-600/20 transition-all flex items-center justify-center space-x-2">
                                <i class="fa-solid fa-wand-sparkles"></i>
                                <span id="generate-btn-text">Generate AI Video (~120 Credits)</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Live Output & Preview Area -->
                <div class="space-y-6">
                    <div class="glass-panel rounded-2xl p-6 shadow-xl flex flex-col h-full justify-between">
                        <div>
                            <h3 class="font-bold text-lg mb-4 flex items-center">
                                <i class="fa-solid fa-display text-indigo-400 mr-2"></i>Live Output Preview
                            </h3>
                            
                            <!-- Video Container / Placeholder -->
                            <div id="video-preview-container" class="w-full aspect-[9/16] max-h-[500px] bg-slate-900/90 rounded-xl border border-slate-800 flex flex-col items-center justify-center relative overflow-hidden group">
                                <div id="preview-placeholder" class="text-center p-6 space-y-3">
                                    <div class="w-16 h-16 rounded-2xl bg-slate-800/80 flex items-center justify-center mx-auto text-purple-400 border border-slate-700">
                                        <i class="fa-solid fa-film text-2xl"></i>
                                    </div>
                                    <p class="text-sm font-medium text-slate-300">Your video will appear here</p>
                                    <p class="text-xs text-slate-500">Generation takes 1 to 3 minutes depending on the model and duration selected.</p>
                                </div>

                                <!-- Loading Spinner Overlay -->
                                <div id="loading-overlay" class="absolute inset-0 bg-slate-950/80 backdrop-blur-md hidden flex-col items-center justify-center p-6 text-center space-y-4">
                                    <div class="relative w-16 h-16">
                                        <div class="absolute inset-0 rounded-full border-4 border-purple-500/20"></div>
                                        <div class="absolute inset-0 rounded-full border-4 border-purple-600 border-t-transparent animate-spin"></div>
                                    </div>
                                    <div class="space-y-1">
                                        <p id="loading-status-text" class="text-sm font-semibold text-white">Rendering AI Video Clip...</p>
                                        <p class="text-xs text-purple-300 animate-pulse">Puter.ai is calling upstream providers...</p>
                                    </div>
                                    <div class="w-48 bg-slate-800 h-1.5 rounded-full overflow-hidden">
                                        <div id="loading-progress-bar" class="bg-gradient-to-r from-purple-500 to-indigo-500 h-full w-1/3 animate-pulse"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action buttons for output -->
                        <div id="output-actions" class="mt-4 pt-4 border-t border-slate-800/80 hidden flex space-x-3">
                            <button onclick="downloadCurrentVideo()" class="flex-1 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold py-2.5 rounded-xl transition-all flex items-center justify-center space-x-1.5">
                                <i class="fa-solid fa-download text-purple-400"></i><span>Download MP4</span>
                            </button>
                            <button onclick="saveToGallery()" class="flex-1 bg-purple-600/20 hover:bg-purple-600/30 border border-purple-500/30 text-purple-300 text-xs font-semibold py-2.5 rounded-xl transition-all flex items-center justify-center space-x-1.5">
                                <i class="fa-solid fa-bookmark text-purple-400"></i><span>Save to Gallery</span>
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- VIEW 2: GALLERY & FILESYSTEM -->
        <div id="view-gallery" class="space-y-6 hidden">
            <div class="glass-panel rounded-2xl p-6 shadow-xl space-y-6">
                <div class="flex items-center justify-between border-b border-slate-800 pb-4">
                    <div>
                        <h2 class="text-xl font-bold flex items-center">
                            <i class="fa-solid fa-folder-open text-purple-400 mr-2.5"></i>Video Gallery & Puter Filesystem
                        </h2>
                        <p class="text-xs text-slate-400 mt-1">Manage your generated clips stored locally or synced with Puter cloud storage.</p>
                    </div>
                    <div class="flex items-center space-x-3">
                        <button onclick="loadGallery()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold px-3 py-2 rounded-xl transition-all">
                            <i class="fa-solid fa-rotate mr-1.5"></i>Refresh
                        </button>
                    </div>
                </div>

                <!-- Gallery Grid -->
                <div id="gallery-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Dynamically populated or empty state -->
                    <div class="col-span-full py-16 text-center space-y-3">
                        <div class="w-16 h-16 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-center mx-auto text-slate-600">
                            <i class="fa-solid fa-video-slash text-2xl"></i>
                        </div>
                        <p class="text-slate-400 text-sm">No videos in your gallery yet.</p>
                        <button onclick="switchTab('create')" class="text-xs text-purple-400 hover:text-purple-300 font-semibold">Generate your first video now &rarr;</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- VIEW 3: MODELS & TOKENS GUIDE -->
        <div id="view-models" class="space-y-6 hidden">
            <div class="glass-panel rounded-2xl p-6 shadow-xl space-y-6">
                <div class="border-b border-slate-800 pb-4">
                    <h2 class="text-xl font-bold flex items-center">
                        <i class="fa-solid fa-microchip text-purple-400 mr-2.5"></i>Available Video Models & Token Costs
                    </h2>
                    <p class="text-xs text-slate-400 mt-1">Detailed comparison of models supported by Puter.ai txt2vid API.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- OpenAI Sora-2-Pro -->
                    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5 space-y-4 flex flex-col justify-between">
                        <div class="space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-purple-950 text-purple-300 border border-purple-800">OpenAI</span>
                                <span class="text-xs font-bold text-amber-400"><i class="fa-solid fa-coins mr-1"></i>120 Credits</span>
                            </div>
                            <h3 class="font-bold text-lg text-white">Sora-2 Pro</h3>
                            <p class="text-xs text-slate-400 leading-relaxed">Top-tier cinematic video generation with phenomenal prompt adherence and visual fidelity.</p>
                        </div>
                        <div class="space-y-2 pt-3 border-t border-slate-800 text-xs text-slate-300">
                            <div class="flex justify-between"><span>Max Duration:</span><span class="font-semibold text-white">4, 8, 12 seconds</span></div>
                            <div class="flex justify-between"><span>Max Resolution:</span><span class="font-semibold text-white">1792x1024</span></div>
                            <div class="flex justify-between"><span>Timeout limit:</span><span class="font-semibold text-white">5 minutes</span></div>
                        </div>
                    </div>

                    <!-- Google Veo 3.1 -->
                    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5 space-y-4 flex flex-col justify-between">
                        <div class="space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-indigo-950 text-indigo-300 border border-indigo-800">Google Veo</span>
                                <span class="text-xs font-bold text-amber-400"><i class="fa-solid fa-coins mr-1"></i>90 Credits</span>
                            </div>
                            <h3 class="font-bold text-lg text-white">Veo 3.1 Preview</h3>
                            <p class="text-xs text-slate-400 leading-relaxed">State-of-the-art video model supporting style reference images and 4K resolutions.</p>
                        </div>
                        <div class="space-y-2 pt-3 border-t border-slate-800 text-xs text-slate-300">
                            <div class="flex justify-between"><span>Max Duration:</span><span class="font-semibold text-white">4, 6, 8 seconds</span></div>
                            <div class="flex justify-between"><span>Max Resolution:</span><span class="font-semibold text-white">3840x2160 (4K)</span></div>
                            <div class="flex justify-between"><span>Timeout limit:</span><span class="font-semibold text-white">10 minutes</span></div>
                        </div>
                    </div>

                    <!-- Together AI -->
                    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5 space-y-4 flex flex-col justify-between">
                        <div class="space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-blue-950 text-blue-300 border border-blue-800">TogetherAI</span>
                                <span class="text-xs font-bold text-amber-400"><i class="fa-solid fa-coins mr-1"></i>30 Credits</span>
                            </div>
                            <h3 class="font-bold text-lg text-white">Together Video XL</h3>
                            <p class="text-xs text-slate-400 leading-relaxed">Fast and cost-effective video generation with granular control over steps and guidance scale.</p>
                        </div>
                        <div class="space-y-2 pt-3 border-t border-slate-800 text-xs text-slate-300">
                            <div class="flex justify-between"><span>Max Duration:</span><span class="font-semibold text-white">Custom FPS/Steps</span></div>
                            <div class="flex justify-between"><span>Max Resolution:</span><span class="font-semibold text-white">Custom Width/Height</span></div>
                            <div class="flex justify-between"><span>Timeout limit:</span><span class="font-semibold text-white">10 minutes</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <!-- Error / Notification Modal -->
    <div id="notification-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="glass-panel max-w-md w-full rounded-2xl p-6 shadow-2xl space-y-4 border border-slate-800">
            <div id="modal-icon-container" class="w-12 h-12 rounded-full bg-red-950/80 text-red-400 flex items-center justify-center text-xl mx-auto border border-red-800">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div class="text-center space-y-1">
                <h3 id="modal-title" class="font-bold text-lg text-white">Generation Notice</h3>
                <p id="modal-message" class="text-xs text-slate-300 leading-relaxed">An error occurred during processing.</p>
            </div>
            <div class="pt-2">
                <button onclick="closeModal()" class="w-full bg-slate-800 hover:bg-slate-700 text-white font-semibold py-2.5 rounded-xl text-xs transition-all">Dismiss</button>
            </div>
        </div>
    </div>

    <script>
        // Global State & Variables
        let currentUser = null;
        let currentGeneratedVideoElement = null;
        let userGallery = [];

        // Initialize on window load
        window.onload = function() {
            initPuterSession();
            loadGalleryFromStorage();
            setupPromptCounter();
            updateModelOptions();
        };

        // Character Counter for prompt
        function setupPromptCounter() {
            const promptInput = document.getElementById('prompt-input');
            const charCount = document.getElementById('prompt-char-count');
            promptInput.addEventListener('input', () => {
                const len = promptInput.value.length;
                charCount.textContent = `${len} / 1000`;
                if(len > 1000) {
                    charCount.classList.add('text-red-400');
                } else {
                    charCount.classList.remove('text-red-400');
                }
            });
        }

        // Tab Navigation
        function switchTab(tabName) {
            const tabs = ['create', 'gallery', 'models'];
            tabs.forEach(t => {
                document.getElementById(`view-${t}`).classList.add('hidden');
                const btnDesktop = document.getElementById(`tab-${t}`);
                const btnMobile = document.getElementById(`mobile-tab-${t}`);
                if(btnDesktop) {
                    btnDesktop.className = "px-4 py-2 rounded-lg text-sm font-medium transition-all text-slate-400 hover:text-white hover:bg-slate-800";
                }
                if(btnMobile) {
                    btnMobile.className = "flex-1 py-2 text-center text-xs font-medium text-slate-400 border-b-2 border-transparent";
                }
            });

            document.getElementById(`view-${tabName}`).classList.remove('hidden');
            const activeDesktop = document.getElementById(`tab-${tabName}`);
            const activeMobile = document.getElementById(`mobile-tab-${tabName}`);
            if(activeDesktop) {
                activeDesktop.className = "px-4 py-2 rounded-lg text-sm font-medium transition-all bg-purple-600 text-white shadow-sm";
            }
            if(activeMobile) {
                activeMobile.className = "flex-1 py-2 text-center text-xs font-medium text-purple-400 border-b-2 border-purple-500";
            }

            if(tabName === 'gallery') {
                loadGallery();
            }
        }

        // Puter Authentication & Session Management
        async function initPuterSession() {
            try {
                // Check local storage for cached puter account
                const cachedUser = localStorage.getItem('subeai_puter_user');
                if (cachedUser) {
                    currentUser = JSON.parse(cachedUser);
                    updateAuthUI(true);
                }

                // Check live puter session if available
                if (typeof puter !== 'undefined' && puter.auth) {
                    const signedIn = await puter.auth.isSignedIn();
                    if (signedIn) {
                        const user = await puter.auth.getUser();
                        currentUser = user;
                        localStorage.setItem('subeai_puter_user', JSON.stringify(user));
                        updateAuthUI(true);
                    }
                }
            } catch (err) {
                console.warn('Puter session check warning:', err);
            }
        }

        async function handlePuterAuth() {
            try {
                if (currentUser) {
                    // Sign out flow
                    if (typeof puter !== 'undefined' && puter.auth && puter.auth.signOut) {
                        await puter.auth.signOut();
                    }
                    localStorage.removeItem('subeai_puter_user');
                    currentUser = null;
                    updateAuthUI(false);
                    showNotification("Signed Out", "Successfully disconnected your Puter account.", "info");
                } else {
                    // Sign in flow
                    if (typeof puter !== 'undefined' && puter.auth && puter.auth.signIn) {
                        await puter.auth.signIn();
                        const user = await puter.auth.getUser();
                        currentUser = user;
                        localStorage.setItem('subeai_puter_user', JSON.stringify(user));
                        updateAuthUI(true);
                        showNotification("Connected!", `Welcome back, ${user.username || 'Puter User'}!`, "success");
                    } else {
                        // Fallback simulation for testing UI outside puter environment
                        currentUser = { username: "demo_user", email: "user@puter.com" };
                        localStorage.setItem('subeai_puter_user', JSON.stringify(currentUser));
                        updateAuthUI(true);
                        showNotification("Demo Mode Connected", "Connected with simulated Puter session.", "success");
                    }
                }
            } catch (err) {
                console.error("Auth error:", err);
                showNotification("Authentication Error", err.message || "Failed to authenticate with Puter.", "error");
            }
        }

        function updateAuthUI(isConnected) {
            const indicator = document.getElementById('auth-status-indicator');
            const usernameEl = document.getElementById('auth-username');
            const tokenDisplay = document.getElementById('token-display');
            const tokenCount = document.getElementById('token-count');
            const btn = document.getElementById('auth-action-btn');

            if (isConnected && currentUser) {
                indicator.className = "w-2.5 h-2.5 rounded-full bg-emerald-500";
                usernameEl.textContent = currentUser.username || currentUser.email || "Connected";
                tokenDisplay.classList.remove('hidden');
                tokenDisplay.classList.add('flex');
                tokenCount.textContent = "1,450"; // Mock remaining token count
                btn.textContent = "Sign Out";
                btn.className = "ml-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold px-3 py-1.5 rounded-full transition-all";
            } else {
                indicator.className = "w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse";
                usernameEl.textContent = "Not Connected";
                tokenDisplay.classList.add('hidden');
                tokenDisplay.classList.remove('flex');
                btn.textContent = "Connect Puter";
                btn.className = "ml-2 bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold px-3 py-1.5 rounded-full transition-all shadow-sm";
            }
        }

        // Model options dynamic cost updates
        function updateModelOptions() {
            const select = document.getElementById('model-select');
            const selectedOption = select.options[select.selectedIndex];
            const cost = selectedOption.getAttribute('data-cost') || '50';
            const btnText = document.getElementById('generate-btn-text');
            btnText.textContent = `Generate AI Video (~${cost} Credits)`;
        }

        // Core Video Generation Function using puter.ai.txt2vid
        async function generateVideo() {
            const prompt = document.getElementById('prompt-input').value.trim();
            const model = document.getElementById('model-select').value;
            const seconds = parseInt(document.getElementById('seconds-select').value);
            const size = document.getElementById('size-select').value;
            const negativePrompt = document.getElementById('negative-prompt-input').value.trim();
            const puterPath = document.getElementById('puter-path-input').value.trim();
            const testMode = document.getElementById('test-mode-toggle').checked;

            if (!prompt) {
                showNotification("Prompt Required", "Please enter a descriptive prompt for your video generation.", "error");
                return;
            }

            // Show loading overlay
            const loadingOverlay = document.getElementById('loading-overlay');
            const loadingStatus = document.getElementById('loading-status-text');
            loadingOverlay.classList.remove('hidden');
            loadingOverlay.classList.add('flex');
            loadingStatus.textContent = testMode ? "Generating Sample Video (Test Mode)..." : `Generating video with ${model} (${seconds}s)...`;

            try {
                let videoElement;

                // Build options object per docs specification
                const options = {
                    model: model,
                    seconds: seconds,
                    size: size,
                    test_mode: testMode
                };

                if (negativePrompt) {
                    options.negative_prompt = negativePrompt;
                }

                if (puterPath) {
                    options.puter_output_path = puterPath;
                }

                // Call Puter.js AI txt2vid API
                if (typeof puter !== 'undefined' && puter.ai && puter.ai.txt2vid) {
                    videoElement = await puter.ai.txt2vid(prompt, options);
                } else {
                    // Fallback simulation when puter.js is offline/testing
                    await new Promise(resolve => setTimeout(resolve, 4000));
                    videoElement = document.createElement('video');
                    videoElement.src = "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4";
                    videoElement.controls = true;
                    videoElement.setAttribute('data-mime-type', 'video/mp4');
                    videoElement.setAttribute('data-source', 'simulation');
                }

                // Render video element into preview container
                const previewContainer = document.getElementById('video-preview-container');
                const placeholder = document.getElementById('preview-placeholder');
                
                // Clear previous video if any
                const existingVideo = previewContainer.querySelector('video');
                if (existingVideo) existingVideo.remove();

                placeholder.classList.add('hidden');
                videoElement.className = "w-full h-full object-cover rounded-xl shadow-lg";
                videoElement.controls = true;
                videoElement.autoplay = true;
                videoElement.muted = false;
                
                previewContainer.appendChild(videoElement);
                currentGeneratedVideoElement = videoElement;

                // Show action buttons
                document.getElementById('output-actions').classList.remove('hidden');
                document.getElementById('output-actions').classList.add('flex');

                showNotification("Success!", "Video clip generated successfully.", "success");

            } catch (err) {
                console.error("Video Generation Error:", err);
                let errorMsg = err.message || "An unexpected error occurred during generation.";
                if (err.code === 'insufficient_funds') {
                    errorMsg = "Your Puter balance cannot cover the estimated cost of this video clip.";
                } else if (err.code === 'upstream_timeout') {
                    errorMsg = "The provider did not finish the clip within the timeout window. Try a shorter clip or faster model.";
                } else if (err.errorCode === 'moderation_flagged') {
                    errorMsg = "The prompt was refused by the provider's content safety filter. Please revise your prompt.";
                }
                showNotification("Generation Failed", errorMsg, "error");
            } finally {
                loadingOverlay.classList.add('hidden');
                loadingOverlay.classList.remove('flex');
            }
        }

        function downloadCurrentVideo() {
            if (!currentGeneratedVideoElement || !currentGeneratedVideoElement.src) {
                showNotification("No Video", "Please generate a video first before downloading.", "error");
                return;
            }
            const a = document.createElement('a');
            a.href = currentGeneratedVideoElement.src;
            a.download = `subeai_video_${Date.now()}.mp4`;
            document.body.appendChild(a);
            a.click();
            a.remove();
        }

        function saveToGallery() {
            if (!currentGeneratedVideoElement || !currentGeneratedVideoElement.src) return;
            const prompt = document.getElementById('prompt-input').value.trim();
            const model = document.getElementById('model-select').value;
            
            const item = {
                id: Date.now(),
                src: currentGeneratedVideoElement.src,
                prompt: prompt,
                model: model,
                date: new Date().toLocaleDateString()
            };

            userGallery.unshift(item);
            localStorage.setItem('subeai_gallery', JSON.stringify(userGallery));
            showNotification("Saved to Gallery", "Your video has been saved to your local gallery.", "success");
        }

        function loadGalleryFromStorage() {
            const cached = localStorage.getItem('subeai_gallery');
            if (cached) {
                try {
                    userGallery = JSON.parse(cached);
                } catch(e) {
                    userGallery = [];
                }
            }
        }

        function loadGallery() {
            loadGalleryFromStorage();
            const grid = document.getElementById('gallery-grid');
            if (userGallery.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full py-16 text-center space-y-3">
                        <div class="w-16 h-16 rounded-2xl bg-slate-900 border border-slate-800 flex items-center justify-center mx-auto text-slate-600">
                            <i class="fa-solid fa-video-slash text-2xl"></i>
                        </div>
                        <p class="text-slate-400 text-sm">No videos in your gallery yet.</p>
                        <button onclick="switchTab('create')" class="text-xs text-purple-400 hover:text-purple-300 font-semibold">Generate your first video now &rarr;</button>
                    </div>
                `;
                return;
            }

            grid.innerHTML = userGallery.map(item => `
                <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-lg flex flex-col justify-between">
                    <div class="aspect-[16/9] bg-slate-950 relative">
                        <video src="${item.src}" class="w-full h-full object-cover" controls preload="metadata"></video>
                    </div>
                    <div class="p-4 space-y-2">
                        <div class="flex items-center justify-between text-xs">
                            <span class="px-2 py-0.5 rounded-full bg-purple-950 text-purple-300 font-medium">${item.model}</span>
                            <span class="text-slate-500">${item.date}</span>
                        </div>
                        <p class="text-xs text-slate-300 line-clamp-2">${item.prompt}</p>
                    </div>
                    <div class="px-4 pb-4 pt-0 flex space-x-2">
                        <button onclick="downloadGalleryItem('${item.src}')" class="flex-1 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs py-2 rounded-xl transition-all">Download</button>
                        <button onclick="deleteGalleryItem(${item.id})" class="px-3 bg-red-950/40 hover:bg-red-900/40 text-red-400 text-xs py-2 rounded-xl transition-all"><i class="fa-solid fa-trash"></i></button>
                    </div>
                </div>
            `).join('');
        }

        function downloadGalleryItem(src) {
            const a = document.createElement('a');
            a.href = src;
            a.download = `subeai_clip_${Date.now()}.mp4`;
            document.body.appendChild(a);
            a.click();
            a.remove();
        }

        function deleteGalleryItem(id) {
            userGallery = userGallery.filter(item => item.id !== id);
            localStorage.setItem('subeai_gallery', JSON.stringify(userGallery));
            loadGallery();
            showNotification("Deleted", "Video removed from local gallery.", "info");
        }

        // Notification Modal Helper
        function showNotification(title, message, type = 'info') {
            const modal = document.getElementById('notification-modal');
            const titleEl = document.getElementById('modal-title');
            const msgEl = document.getElementById('modal-message');
            const iconContainer = document.getElementById('modal-icon-container');

            titleEl.textContent = title;
            msgEl.textContent = message;

            if (type === 'success') {
                iconContainer.className = "w-12 h-12 rounded-full bg-emerald-950/80 text-emerald-400 flex items-center justify-center text-xl mx-auto border border-emerald-800";
                iconContainer.innerHTML = '<i class="fa-solid fa-check"></i>';
            } else if (type === 'error') {
                iconContainer.className = "w-12 h-12 rounded-full bg-red-950/80 text-red-400 flex items-center justify-center text-xl mx-auto border border-red-800";
                iconContainer.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i>';
            } else {
                iconContainer.className = "w-12 h-12 rounded-full bg-purple-950/80 text-purple-400 flex items-center justify-center text-xl mx-auto border border-purple-800";
                iconContainer.innerHTML = '<i class="fa-solid fa-circle-info"></i>';
            }

            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeModal() {
            const modal = document.getElementById('notification-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    </script>
</body>
</html>
